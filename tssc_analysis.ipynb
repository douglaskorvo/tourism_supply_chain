   ],
   "source": [
    "g = df.groupby(\"place_id\")\n",
    "n_j = g.place_id.transform(\"size\")\n",
    "df[\"coord_loo\"] = (g.coordination.transform(\"sum\") - df.coordination) / (n_j - 1)\n",
    "df[\"disr_loo\"]  = (g.disruption.transform(\"sum\")  - df.disruption)  / (n_j - 1)\n",
    "\n",
    "multi = df[n_j > 1].copy()\n",
    "m_loo, or_loo = logit(f\"negative ~ coord_loo + disr_loo + mass_market + {CTRL}\", multi,\n",
    "                      \"Leave-one-out provider-level indicators\",\n",
    "                      [\"coord_loo\", \"disr_loo\", \"mass_market\"])\n",
    "print(\"\\nrescaled to a ten-percentage-point increase:\")\n",
    "for k in [\"coord_loo\", \"disr_loo\"]:\n",
    "    print(f\"  {k:10s} OR = {np.exp(m_loo.params[k]*0.1):.2f}  (p = {m_loo.pvalues[k]:.4f})\")\n",
    "\n",
    "# same-source comparison\n",
    "logit(f\"negative ~ coordination + disruption + mass_market + {CTRL}\", multi,\n",
    "      \"Same-source indicators (for comparison)\", [\"coordination\", \"disruption\"]);"
   ]
  },
