   "source": [
    "# ------------------------------------------------- Equation (2): conditional impact\n",
    "m2, or2 = logit(f\"negative ~ mass_market * disruption + {CTRL}\", df,\n",
    "                \"Equation (2) — dissatisfaction with interaction\",\n",
    "                [\"mass_market\", \"disruption\", \"mass_market:disruption\"])"
   ]
  },
