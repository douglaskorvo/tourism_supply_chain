   "source": [
    "# alternative outcome specifications\n",
    "ols = smf.ols(f\"rating ~ mass_market + disruption + delay + coordination + {CTRL}\",\n",
    "              data=df).fit(cov_type=\"cluster\", cov_kwds={\"groups\": df.place_id})\n",
    "print(\"OLS on the 1-5 rating:\")\n",
    "for k in [\"mass_market\", \"disruption\", \"delay\", \"coordination\"]:\n",
    "    print(f\"  {k:14s} b = {ols.params[k]:+.3f}  (p = {ols.pvalues[k]:.4f})\")\n",
    "\n",
    "# provider-level aggregation, weighted by number of retrieved reviews\n",
    "prov = (df.groupby(\"place_id\")\n",
    "          .agg(country=(\"country\", \"first\"), city=(\"city\", \"first\"),\n",
    "               mass_market=(\"mass_market\", \"first\"), n=(\"rating\", \"size\"),\n",
    "               mean_rating=(\"rating\", \"mean\"), disruption_share=(\"disruption\", \"mean\"),\n",
    "               words=(\"n_words\", \"mean\")).reset_index())\n",
    "prov[\"log_words\"] = np.log1p(prov.words)\n",
    "for dep in [\"mean_rating\", \"disruption_share\"]:\n",
    "    w = smf.wls(f\"{dep} ~ mass_market + log_words + C(country)\", data=prov, weights=prov.n).fit(cov_type=\"HC3\")\n",
    "    print(f\"\\nprovider level — {dep}: b(mass_market) = {w.params['mass_market']:+.4f} (p = {w.pvalues['mass_market']:.4f})\")\n",
    "prov.to_csv(CFG[\"outdir\"] / \"provider_level.csv\", index=False)"
   ]
