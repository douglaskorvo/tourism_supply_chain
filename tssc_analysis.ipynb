    "KEEP = [\"place_id\", \"country\", \"city\", \"segment\", \"mass_market\", \"rating\", \"negative\",\n",
    "        \"text\", \"n_words\", \"log_words\", \"review_age\", \"translated\", \"repeated_text\",\n",
    "        \"ambiguous_config\", \"stage_breadth\", \"disruption\", \"recovery\"] + list(STAGES) + list(CONSTRUCTS)\n",
    "df[KEEP].to_csv(CFG[\"outdir\"] / \"reviews_coded.csv\", index=False)\n",
    "\n",
    "# de-identified version for deposit\n",
    "dep = df[KEEP].copy()\n",
    "dep[\"place_id\"] = \"P\" + pd.Series(pd.factorize(dep.place_id)[0], index=dep.index).astype(str).str.zfill(5)\n",
    "dep = dep.drop(columns=[\"text\"])\n",
    "dep.to_csv(CFG[\"outdir\"] / \"reviews_coded_deidentified.csv\", index=False)\n",
    "\n",
    "print(\"files written to\", CFG[\"outdir\"].resolve())\n",
