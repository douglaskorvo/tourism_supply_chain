    "# ------------------------------------------------- derived variables (Section 2.3)\n",
    "df[\"negative\"]  = (df.rating <= 2).astype(int)          # primary outcome\n",
    "df[\"n_words\"]   = df.text.str.split().str.len()\n",
    "df[\"log_words\"] = np.log1p(df.n_words)\n",
    "\n",
    "PT_NUM = {\"um\": 1, \"uma\": 1, \"dois\": 2, \"duas\": 2}\n",
    "def to_years(s):\n",
    "    '''Approximate review age from the platform relative time descriptor.'''\n",
    "    s = s.lower()\n",
    "    if any(k in s for k in (\"hora\", \"dia\", \"última semana\", \"ultima semana\")):\n",
    "        return 0.0\n",
    "    m = re.search(r\"(\\d+)\", s)\n",
    "    n = int(m.group(1)) if m else PT_NUM.get(s.split()[0], 1)\n",
    "    if \"semana\" in s: return round(n * 7 / 365, 3)\n",
    "    if \"mês\" in s or \"mes\" in s: return round(n / 12, 3)\n",
    "    if \"ano\" in s: return float(n)\n",
    "    return np.nan\n",
    "\n",
    "df[\"review_age\"] = df.time_desc.apply(to_years)\n",
    "\n",
    "# probable machine translation: heuristic on delivered locale and country (Section 2.2)\n",
    "df[\"translated\"] = np.where(df.country.eq(\"Brazil\"),\n",
    "                            (df.lang == \"pt-BR\").astype(int),\n",
    "                            (~df.lang.isin([\"pt\"])).astype(int))\n",
    "\n",
    "df[\"mass_market\"] = (df.segment == \"mass_market\").astype(int)   # principal exposure M_j\n",
    "\n",
    "print(f\"analytical corpus: {len(df):,} reviews · {df.place_id.nunique():,} providers · \"\n",
    "      f\"{df.city.nunique()} cities · {df.country.nunique()} countries\")"
   ]
