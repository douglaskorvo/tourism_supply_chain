   "source": [
    "# ------------------------------------------- cross-country heterogeneity (Figure 5)\n",
    "joint = smf.logit(f\"disruption ~ mass_market * C(country) + log_words + review_age + translated\", data=df).fit(disp=0)\n",
    "terms = [t for t in joint.params.index if \"mass_market:\" in t]\n",
    "print(\"joint test of configuration-by-country interaction:\")\n",
    "print(joint.f_test(\" = 0, \".join(terms) + \" = 0\"))\n",
    "\n",
    "het = []\n",
    "for c, s in df.groupby(\"country\"):\n",
    "    if s.disruption.sum() < 15:\n",
    "        continue\n",
    "    m = smf.logit(\"disruption ~ mass_market + log_words + review_age\", data=s).fit(\n",
    "        disp=0, cov_type=\"cluster\", cov_kwds={\"groups\": s.place_id})\n",
    "    ci = m.conf_int()\n",
    "    het.append({\"country\": c, \"OR\": np.exp(m.params[\"mass_market\"]),\n",
    "                \"lo\": np.exp(ci[0][\"mass_market\"]), \"hi\": np.exp(ci[1][\"mass_market\"]),\n",
    "                \"p\": m.pvalues[\"mass_market\"], \"events\": int(s.disruption.sum())})\n",
    "het = pd.DataFrame(het).sort_values(\"OR\")\n",
    "het.to_csv(CFG[\"outdir\"] / \"Table4_country_heterogeneity.csv\", index=False)\n",
    "display(het.round(3))\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(5.6, 3.2)); y = np.arange(len(het))\n",
    "ax.hlines(y, het.lo, het.hi, color=C_NEUT, lw=1.6, alpha=.7)\n",
    "ax.scatter(het.OR, y, s=np.sqrt(het.events)*6, zorder=3,\n",
    "           color=[C_LONG if p < .05 else \"#AAAAAA\" for p in het.p])\n",
    "ax.axvline(1, color=C_NEUT, ls=\"--\", lw=.8); ax.set_xscale(\"log\")\n",
    "ax.set_yticks(y); ax.set_yticklabels([f\"{c} (events={n})\" for c, n in zip(het.country, het.events)], fontsize=8)\n",
    "ax.set_xlabel(\"Odds ratio: mass-market configuration -> reported disruption (log scale)\")\n",
    "ax.set_title(\"Figure 5. Exploratory cross-country estimates\", loc=\"left\", fontweight=\"bold\", fontsize=9.5)\n",
    "ax.text(0, -.18, \"Filled markers: p < 0.05. Markets with fewer than 15 reported disruptions omitted. \"\n",
    "                 \"Differences in significance are not tests of between-country differences.\",\n",
    "        transform=ax.transAxes, fontsize=6.4, color=C_NEUT)\n",
    "fig.savefig(CFG[\"outdir\"] / \"fig5_country_heterogeneity.png\"); plt.show()"
   ]
  },
