   "source": [
    "SUBSAMPLES = {\n",
    "    \"Full sample\":                df,\n",
    "    \"Reviews >= 50 words\":        df[df.n_words >= 50],\n",
    "    \"Excluding Brazil\":           df[df.country != \"Brazil\"],\n",
    "    \"Probably translated only\":   df[df.translated == 1],\n",
    "    \"Excluding repeated texts\":   df[~df.repeated_text],\n",
    "    \"Reviews <= 2 years\":         df[df.review_age <= 2],\n",
    "    \"Providers with >1 review\":   df[n_j > 1],\n",
    "}\n",
    "\n",
    "def quiet_or(formula, data, key):\n",
    "    f = formula\n",
    "    for v in [\"translated\", \"review_age\"]:\n",
    "        if data[v].nunique() < 2:\n",
    "            f = f.replace(f\" + {v}\", \"\")\n",
    "    m = smf.logit(f, data=data).fit(disp=0, cov_type=\"cluster\", cov_kwds={\"groups\": data.place_id})\n",
    "    return np.exp(m.params[key]), m.pvalues[key], int(m.nobs)\n",
    "\n",
    "rob = []\n",
    "for lbl, s in SUBSAMPLES.items():\n",
    "    o1, p1, n1 = quiet_or(f\"disruption ~ mass_market + {CTRL}\", s, \"mass_market\")\n",
    "    o2, p2, _  = quiet_or(f\"negative ~ mass_market * disruption + {CTRL}\", s, \"mass_market:disruption\")\n",
    "    rob.append({\"subsample\": lbl, \"n\": n1, \"OR_exposure\": round(o1, 2), \"p_exposure\": round(p1, 4),\n",
    "                \"OR_interaction\": round(o2, 2), \"p_interaction\": round(p2, 4)})\n",
    "rob = pd.DataFrame(rob)\n",
    "rob.to_csv(CFG[\"outdir\"] / \"Table3_robustness.csv\", index=False)\n",
    "display(rob)"
   ]
  },
