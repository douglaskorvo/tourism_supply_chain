    "LBL = {\"stage_booking\": \"Booking / payment\", \"stage_transport\": \"Transport / transfer\",\n",
    "       \"stage_lodging\": \"Accommodation\", \"stage_food\": \"Food service\",\n",
    "       \"stage_delivery\": \"Experience delivery\", \"intermediation\": \"Intermediary (agency/operator)\",\n",
    "       \"coordination\": \"Orchestration / planning\"}\n",
    "v = sorted([(l, 100*df.loc[df.mass_market==0, k].mean(), 100*df.loc[df.mass_market==1, k].mean())\n",
    "            for k, l in LBL.items()], key=lambda x: x[2])\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(6.6, 3.4)); y = np.arange(len(v))\n",
    "ax.barh(y - .2, [x[1] for x in v], .4, color=C_SHORT, label=f\"Creative experience (n={int((df.mass_market==0).sum()):,})\")\n",
    "ax.barh(y + .2, [x[2] for x in v], .4, color=C_LONG,  label=f\"Mass market / tour (n={int(df.mass_market.sum()):,})\")\n",
    "for i, x in enumerate(v):\n",
    "    ax.text(x[1] + .4, i - .2, f\"{x[1]:.1f}\", va=\"center\", fontsize=7.5, color=C_SHORT)\n",
    "    ax.text(x[2] + .4, i + .2, f\"{x[2]:.1f}\", va=\"center\", fontsize=7.5, color=C_LONG)\n",
    "ax.set_yticks(y); ax.set_yticklabels([x[0] for x in v]); ax.set_xlim(0, 65)\n",
    "ax.set_xlabel(\"% of reviews mentioning the stage or construct\")\n",
    "ax.legend(frameon=False, fontsize=8, loc=\"lower right\")\n",
    "ax.set_title(\"Figure 1. Dictionary prevalence by collection stratum\", loc=\"left\", fontweight=\"bold\", fontsize=10)\n",
    "fig.savefig(CFG[\"outdir\"] / \"fig1_prevalence_by_configuration.png\"); plt.show()"
