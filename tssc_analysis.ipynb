    "# ------------------------------------- construct prevalence by configuration (3.1)\n",
    "rows = []\n",
    "for k in list(STAGES) + list(CONSTRUCTS) + [\"disruption\", \"recovery\"]:\n",
    "    rows.append({\"construct\": k,\n",
    "                 \"all_%\":  100 * df[k].mean(),\n",
    "                 \"creative_%\": 100 * df.loc[df.mass_market == 0, k].mean(),\n",
    "                 \"mass_market_%\": 100 * df.loc[df.mass_market == 1, k].mean()})\n",
    "prev = pd.DataFrame(rows).round(2).sort_values(\"all_%\", ascending=False)\n",
    "prev.to_csv(CFG[\"outdir\"] / \"Table2_construct_prevalence.csv\", index=False)\n",
    "display(prev)\n",
    "\n",
    "print(f\"\\nreview-stage breadth — creative {df.loc[df.mass_market==0,'stage_breadth'].mean():.2f} | \"\n",
    "      f\"mass-market {df.loc[df.mass_market==1,'stage_breadth'].mean():.2f}\")"
   ]
