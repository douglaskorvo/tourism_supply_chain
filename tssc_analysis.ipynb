     "height": 322
    },
    "id": "b44b62ba",
    "outputId": "1b7e68c3-7899-4419-974f-3a824d3840e5"
   },
   "outputs": [],
   "source": [
    "# --------------------------------- exposure / severity / net decomposition (3.4)\n",
    "dec = []\n",
    "for lbl, g in [(\"Creative experience\", df[df.mass_market == 0]), (\"Mass market / tour\", df[df.mass_market == 1])]:\n",
    "    dec.append({\"configuration\": lbl,\n",
    "                \"exposure_%\": 100 * g.disruption.mean(),\n",
    "                \"severity_% (neg | disruption)\": 100 * g.loc[g.disruption == 1, \"negative\"].mean(),\n",
    "                \"net_% negative\": 100 * g.negative.mean(),\n",
    "                \"n_disruptions\": int(g.disruption.sum())})\n",
    "dec = pd.DataFrame(dec).round(2)\n",
    "display(dec)\n",
    "\n",
    "# Two-proportion z test. The outcome is binary, so a Welch t is not the right test\n",
    "# and its statistic must not be labelled z.\n",
    "from statsmodels.stats.proportion import proportions_ztest\n",
    "a = df.loc[(df.mass_market == 0) & (df.disruption == 1), \"negative\"]\n",
    "b = df.loc[(df.mass_market == 1) & (df.disruption == 1), \"negative\"]\n",
    "z, p = proportions_ztest([int(a.sum()), int(b.sum())], [len(a), len(b)])\n",
    "print(f\"severity contrast (two-proportion z): z = {z:.4f}, p = {p:.4f}\")\n",
    "\n",
    "# average marginal predicted probabilities (no reference profile)\n",
    "amp = []\n",
    "for mm in (0, 1):\n",
    "    for d_ in (0, 1):\n",
    "        s = df.assign(mass_market=mm, disruption=d_)\n",
    "        amp.append({\"mass_market\": mm, \"disruption\": d_, \"P(negative) %\": 100 * m2.predict(s).mean()})\n",
    "amp = pd.DataFrame(amp).round(2)\n",
    "display(amp)"
   ]
  },
