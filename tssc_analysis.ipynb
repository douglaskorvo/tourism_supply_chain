   "source": [
    "# ------------------------------- 5a. magnitude of the dictionary corrections (3.2)\n",
    "BROAD_ENV   = r\"sustent|ambient|natureza|lixo|polui|ecol[óo]g|preserv|reciclag\"\n",
    "broad = match(BROAD_ENV)\n",
    "print(\"Environmental construct\")\n",
    "print(f\"  broad pattern    : {100*broad.mean():5.2f}%  (creative {100*broad[df.mass_market==0].mean():.2f}% \"\n",
    "      f\"vs mass-market {100*broad[df.mass_market==1].mean():.2f}%)\")\n",
    "print(f\"  frozen dictionary: {100*df.environmental.mean():5.2f}%  (creative {100*df.loc[df.mass_market==0,'environmental'].mean():.2f}% \"\n",
    "      f\"vs mass-market {100*df.loc[df.mass_market==1,'environmental'].mean():.2f}%)\")\n",
    "print(\"  -> the stem 'ambient-' also denotes venue atmosphere; the broad pattern inflates prevalence and\")\n",
    "print(\"     manufactures a between-configuration difference that does not survive disambiguation.\\n\")\n",
    "\n",
    "neg_delay = match(NO_DELAY).astype(bool)\n",
    "raw_delay = match(CONSTRUCTS[\"delay\"]).astype(bool)\n",
    "print(\"Delay construct\")\n",
    "print(f\"  explicit 'no delay' phrasings: {int(neg_delay.sum())}, of which {int((neg_delay & raw_delay).sum())} \"\n",
    "      f\"matched the base pattern before negation rules were applied\")"
   ]
