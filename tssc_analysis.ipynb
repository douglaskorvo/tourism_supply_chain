   "source": [
    "# ------------------------------------ 5b. measurement opportunity (Figure 6, 3.2)\n",
    "r = np.corrcoef(df.stage_breadth, df.log_words)[0, 1]\n",
    "print(f\"corr(stage breadth, log words) = {r:.3f}\")\n",
    "\n",
    "by_breadth = df.groupby(\"stage_breadth\").agg(n=(\"rating\", \"size\"),\n",
    "                                             disruption=(\"disruption\", \"mean\"),\n",
    "                                             negative=(\"negative\", \"mean\")).round(4)\n",
    "display(by_breadth)\n",
    "\n",
    "df[\"len_q\"] = pd.qcut(df.n_words, 5, labels=[\"Q1\", \"Q2\", \"Q3\", \"Q4\", \"Q5\"])\n",
    "strat = pd.crosstab(df.len_q, df.stage_breadth, values=df.disruption, aggfunc=\"mean\").mul(100)\n",
    "display(strat.round(2))\n",
    "\n",
    "fig, axs = plt.subplots(1, 2, figsize=(7.2, 3.0))\n",
    "a = by_breadth.disruption * 100\n",
    "axs[0].bar(a.index, a.values, color=C_LONG, width=.65)\n",
    "for x, vv in zip(a.index, a.values):\n",
    "    axs[0].text(x, vv + .25, f\"{vv:.1f}\", ha=\"center\", fontsize=7.5)\n",
    "axs[0].set_xlabel(\"Review-stage breadth\"); axs[0].set_ylabel(\"% reporting disruption\")\n",
    "axs[0].set_title(\"(a) Unadjusted association\", fontsize=8.5)\n",
    "for i, q in enumerate(strat.index):\n",
    "    s = strat.loc[q].dropna()\n",
    "    axs[1].plot(s.index, s.values, \"o-\", ms=4, lw=1.4, color=plt.cm.viridis(i / 4), label=f\"{q} length\")\n",
    "axs[1].set_xlabel(\"Review-stage breadth\"); axs[1].set_ylabel(\"% reporting disruption\")\n",
    "axs[1].set_title(\"(b) Within review-length quintiles\", fontsize=8.5); axs[1].legend(frameon=False, fontsize=7)\n",
    "fig.suptitle(\"Figure 6. Review-stage breadth and reported disruption: the measurement-opportunity confound\",\n",
    "             x=.005, ha=\"left\", fontweight=\"bold\", fontsize=9.5, y=1.04)\n",
    "fig.savefig(CFG[\"outdir\"] / \"fig6_measurement_opportunity.png\"); plt.show()"
   ]
  },
