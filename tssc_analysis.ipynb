   "source": [
    "# adjusted estimates for stage breadth (reported in 3.2)\n",
    "CTRL = \"log_words + review_age + translated + \" + CFG[\"fe\"]\n",
    "\n",
    "def logit(formula, data, label, keys):\n",
    "    m = smf.logit(formula, data=data).fit(disp=0, cov_type=\"cluster\",\n",
    "                                          cov_kwds={\"groups\": data.place_id})\n",
    "    ci = m.conf_int()\n",
    "    out = pd.DataFrame({\"OR\": np.exp(m.params), \"CI_low\": np.exp(ci[0]),\n",
    "                        \"CI_high\": np.exp(ci[1]), \"p\": m.pvalues}).loc[keys].round(4)\n",
    "    print(f\"\\n### {label}   n={int(m.nobs):,}  clusters={data.place_id.nunique():,}  pseudo-R2={m.prsquared:.3f}\")\n",
    "    print(out.to_string())\n",
    "    return m, out\n",
    "\n",
    "logit(f\"disruption ~ stage_breadth + {CTRL}\", df, \"Stage breadth -> reported disruption\", [\"stage_breadth\"])\n",
    "logit(f\"negative ~ stage_breadth + {CTRL}\",   df, \"Stage breadth -> negative rating\",     [\"stage_breadth\"]);"
   ]
  },
