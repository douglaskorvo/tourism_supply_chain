   "source": [
    "# ------------------------------------------------------------------------ Table 1\n",
    "tab1 = (df.groupby(\"country\")\n",
    "          .agg(Cities=(\"city\", \"nunique\"),\n",
    "               Providers=(\"place_id\", \"nunique\"),\n",
    "               Creative=(\"mass_market\", lambda s: int((s == 0).sum())),\n",
    "               MassMarket=(\"mass_market\", \"sum\"),\n",
    "               Total=(\"rating\", \"size\"),\n",
    "               MeanRating=(\"rating\", \"mean\"),\n",
    "               Translated=(\"translated\", lambda s: 100 * s.mean()))\n",
    "          .sort_values(\"Total\", ascending=False).round(2))\n",
    "tab1.loc[\"Total\"] = [df.city.nunique(), df.place_id.nunique(), int((df.mass_market == 0).sum()),\n",
    "                     int(df.mass_market.sum()), len(df), round(df.rating.mean(), 2),\n",
    "                     round(100 * df.translated.mean(), 1)]\n",
    "tab1.to_csv(CFG[\"outdir\"] / \"Table1_sample_composition.csv\")\n",
    "display(tab1)\n",
    "\n",
    "print(f\"\\nfive-star share: {(df.rating == 5).mean()*100:.1f}%   one-or-two-star share: {df.negative.mean()*100:.2f}%\")\n",
    "print(f\"review length (words): median {df.n_words.median():.0f}, IQR {df.n_words.quantile(.25):.0f}-{df.n_words.quantile(.75):.0f}\")\n",
    "print(f\"review age (years): median {df.review_age.median():.2f}; within two years {100*(df.review_age <= 2).mean():.1f}%\")"
   ]
  },
