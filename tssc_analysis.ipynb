0.04488610984639744,\n        \"min\": 0.0009,\n        \"max\": 0.1302,\n        \"num_unique_values\": 7,\n        \"samples\": [\n          0.0181\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"
