   "source": [
    "# ---------------------------------------------------------- Equation (1): exposure\n",
    "m1, or1 = logit(f\"disruption ~ mass_market + {CTRL}\", df, \"Equation (1) — exposure\", [\"mass_market\"])\n",
    "\n",
    "# sensitivity: country fixed effects\n",
    "CTRL_C = \"log_words + review_age + translated + \" + CFG[\"fe_sens\"]\n",
    "logit(f\"disruption ~ mass_market + {CTRL_C}\", df, \"Equation (1) — country fixed effects\", [\"mass_market\"]);"
   ]
  },
