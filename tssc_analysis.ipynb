    "# providers retrieved under both search strata (recorded before any deletion)\n",
    "AMBIGUOUS = set(df.groupby(\"place_id\")[\"segment\"].nunique().pipe(lambda s: s[s > 1]).index)\n",
    "print(f\"providers retrieved under both strata: {len(AMBIGUOUS)}\")\n",
    "\n",
    "df = df[df[\"text\"].notna()].copy()\n",
    "step(\"1. After removing records without text\", len(df))\n",
    "\n",
    "before = len(df)\n",
    "df = df.drop_duplicates(subset=[\"place_id\", \"author_name\", \"text\"], keep=\"first\").copy()\n",
    "step(f\"2. After removing exact duplicates (-{before - len(df)})\", len(df))\n",
    "\n",
    "df[\"repeated_text\"] = df.duplicated(subset=[\"text\"], keep=False) & (df[\"text\"].str.len() > 15)\n",
    "df[\"ambiguous_config\"] = df[\"place_id\"].isin(AMBIGUOUS)\n",
    "df[\"segment\"] = df[\"place_id\"].map(df.groupby(\"place_id\")[\"segment\"].agg(lambda s: s.value_counts().index[0]))\n",
    "\n",
    "if CFG[\"drop_ambiguous\"]:\n",
    "    df = df[~df.ambiguous_config].copy()\n",
    "    step(\"3. After excluding ambiguous-configuration providers\", len(df))\n",
    "\n",
    "pd.DataFrame(LOG).to_csv(CFG[\"outdir\"] / \"TableS1_exclusion_log.csv\", index=False)"
